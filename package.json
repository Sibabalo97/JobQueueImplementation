{
  "name": "job-queue",
  "version": "1.0.0",
  "description": "A configurable job queue with concurrency and rate limiting",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "node --loader ts-node/esm --experimental-specifier-resolution=node src/tests/jobQueue.test.ts",
    "lint": "eslint src/**/*.ts",
    "start": "node --loader ts-node/esm src/index.ts",
    "dev": "ts-node-dev --esm src/index.ts"
  },
  "keywords": [
    "queue",
    "job",
    "async",
    "concurrency",
    "rate-limit"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.7.3",
    "@typescript-eslint/parser": "^6.7.3",
    "eslint": "^8.50.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}